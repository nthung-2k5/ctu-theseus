{
  "title": "InferenceTask",
  "type": "object",
  "required": [
    "inferenceId",
    "runId",
    "payload"
  ],
  "properties": {
    "inferenceId": {
      "format": "uuid",
      "type": "string"
    },
    "runId": {
      "format": "uuid",
      "type": "string"
    },
    "topK": {
      "minimum": 1,
      "maximum": 1000,
      "default": 100,
      "anyOf": [
        {
          "format": "integer",
          "default": 0,
          "type": "string"
        },
        {
          "minimum": 1,
          "maximum": 1000,
          "default": 100,
          "type": "integer"
        }
      ]
    },
    "payload": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "uploadKey",
            "uploadFilename"
          ],
          "properties": {
            "kind": {
              "const": "file",
              "type": "string"
            },
            "uploadKey": {
              "type": "string"
            },
            "uploadFilename": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "fields"
          ],
          "properties": {
            "kind": {
              "const": "text",
              "type": "string"
            },
            "fields": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "type": "string"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "record"
          ],
          "properties": {
            "kind": {
              "const": "record",
              "type": "string"
            },
            "record": {
              "type": "object",
              "patternProperties": {
                "^(.*)$": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "uploadKey",
            "uploadFilename"
          ],
          "properties": {
            "kind": {
              "const": "batch",
              "type": "string"
            },
            "uploadKey": {
              "type": "string"
            },
            "uploadFilename": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}