# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required by apphost.mts: the AppHost refuses to start without it. Signs the JWT access tokens.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Optional: host port RustFS's S3 API is published on under Aspire (default 9000). The browser loads dataset
# images and downloads from it directly via presigned URLs; change it only if 9000 is taken on your machine.
S3_HOST_PORT=

# Optional: extra browser origins allowed to make cookie-authenticated writes (comma separated).
# Same-host requests, including through the AppHost proxy, need no entry.
ALLOWED_ORIGINS=

# The settings below are injected by Aspire. Set them only when running ai_service/ standalone
# (cd ai_service && uv run python main.py), which needs Postgres 18 and an S3-compatible store.
CTU_THESEUS_DB_URI=postgres://theseus:theseus@127.0.0.1:5432/theseus
S3_ENDPOINT=http://localhost:9000
# Only when the API cannot reach S3 at an address the browser can (Aspire sets this itself): the address
# the BROWSER uses, put into presigned download URLs. Defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ctu-theseus
S3_SECRET_KEY=ctu-theseus-secret

# "production" makes missing config (JWT_SECRET, DB, S3) fail at startup instead of using dev fallbacks,
# and marks auth cookies Secure.
ENVIRONMENT=development
