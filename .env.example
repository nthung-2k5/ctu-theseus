# Copy to .env and fill in. .env is gitignored; never commit real values.

# Required by apphost.mts — the AppHost refuses to start without it.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Postgres. Aspire injects this for the gateway; set it only when running
# server/ standalone.
CTU_THESEUS_DB_URI=postgres://theseus:theseus@localhost:5432/theseus

# S3-compatible object store (RustFS under Aspire). The gateway
# (server/lib/config.ts) and the worker (ai_service/config.py) must agree on
# these — they are read by both.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=ctu-theseus
S3_SECRET_KEY=ctu-theseus-secret

# NATS (JetStream)
NATS_URI=nats://localhost:4222

# Set to "production" to make missing config above fail at startup instead of
# falling back to the local-dev defaults.
NODE_ENV=development
