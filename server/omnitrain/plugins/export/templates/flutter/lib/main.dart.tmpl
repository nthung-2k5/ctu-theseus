// OmniTrain-generated demo app. Loads the bundled ONNX model once at startup
// and runs every prediction fully on-device — no server, no network call.
//
// Includes a built-in self-check (see VerifyScreen) that runs the bundled
// sample image through this app's own preprocessing and compares it to
// expected.json, the platform's own prediction for that same sample. That
// comparison is the only thing in this bundle that proves the preprocessing
// re-implemented in omnitrain_client.dart actually matches what Ludwig did at
// training time — see README.md.

import 'dart:convert';
import 'dart:math' as math;
import 'dart:typed_data';
import 'dart:ui' as ui;

import 'package:flutter/material.dart';
import 'package:flutter/services.dart' show rootBundle;
import 'package:image_picker/image_picker.dart';
import 'package:onnxruntime/onnxruntime.dart';

import 'omnitrain_client.dart';

Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  OrtEnv.instance.init();
  runApp(const OmniTrainApp());
}

class OmniTrainApp extends StatelessWidget {
  const OmniTrainApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: '{{RUN_NAME}}',
      theme: ThemeData(colorSchemeSeed: const Color(0xFF1864AB), useMaterial3: true),
      home: const HomeScreen(),
    );
  }
}

class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  final _client = OmniTrainClient();
  final _picker = ImagePicker();

  bool _loading = true;
  String? _error;
  Uint8List? _previewBytes;
  Map<String, double>? _predictions;
  // An object detector's result: the boxes, and the picture's size to lay them over it.
  List<Detection>? _detections;
  double? _imageAspect;
  bool _predicting = false;

  @override
  void initState() {
    super.initState();
    _client.load().then(
      (_) => setState(() => _loading = false),
      onError: (Object e) => setState(() {
        _loading = false;
        _error = e.toString();
      }),
    );
  }

  @override
  void dispose() {
    _client.dispose();
    super.dispose();
  }

  Future<void> _pickAndPredict(ImageSource source) async {
    final picked = await _picker.pickImage(source: source);
    if (picked == null) return;

    final bytes = await picked.readAsBytes();
    setState(() {
      _previewBytes = bytes;
      _predicting = true;
      _predictions = null;
      _detections = null;
    });

    try {
      if (_client.isDetector) {
        final detections = await _client.detect(bytes);
        final image = await decodeImageFromBytes(bytes);
        setState(() {
          _detections = detections;
          _imageAspect = image.width / image.height;
        });
      } else {
        final predictions = await _client.predict(bytes);
        setState(() => _predictions = predictions);
      }
    } catch (e) {
      setState(() => _error = e.toString());
    } finally {
      setState(() => _predicting = false);
    }
  }

  Future<ui.Image> decodeImageFromBytes(Uint8List bytes) async {
    final codec = await ui.instantiateImageCodec(bytes);
    return (await codec.getNextFrame()).image;
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('{{RUN_NAME}}'),
        actions: [
          IconButton(
            icon: const Icon(Icons.fact_check_outlined),
            tooltip: 'Run built-in self-check',
            onPressed: _loading ? null : () => Navigator.of(context).push(MaterialPageRoute<void>(builder: (_) => VerifyScreen(client: _client))),
          ),
        ],
      ),
      body: Center(
        child: _loading
            ? const CircularProgressIndicator()
            : _error != null
                ? Padding(padding: const EdgeInsets.all(24), child: Text('Error: $_error'))
                : SingleChildScrollView(
                    padding: const EdgeInsets.all(24),
                    child: Column(
                      children: [
                        const Text('{{TASK}}', style: TextStyle(fontWeight: FontWeight.w600)),
                        const SizedBox(height: 4),
                        const Text('Runs fully on-device — nothing is uploaded.', style: TextStyle(fontSize: 12, color: Colors.grey)),
                        const SizedBox(height: 16),
                        if (_previewBytes != null && _detections != null && _imageAspect != null)
                          // The boxes are fractions of the picture, so the picture is shown whole, at its own aspect.
                          ClipRRect(
                            borderRadius: BorderRadius.circular(12),
                            child: AspectRatio(
                              aspectRatio: _imageAspect!,
                              child: Stack(
                                fit: StackFit.expand,
                                children: [
                                  Image.memory(_previewBytes!, fit: BoxFit.fill),
                                  CustomPaint(painter: _BoxPainter(_detections!)),
                                ],
                              ),
                            ),
                          )
                        else if (_previewBytes != null)
                          ClipRRect(
                            borderRadius: BorderRadius.circular(12),
                            child: Image.memory(_previewBytes!, height: 220, fit: BoxFit.cover),
                          ),
                        const SizedBox(height: 16),
                        Row(
                          mainAxisAlignment: MainAxisAlignment.center,
                          children: [
                            FilledButton.icon(
                              onPressed: () => _pickAndPredict(ImageSource.camera),
                              icon: const Icon(Icons.camera_alt_outlined),
                              label: const Text('Camera'),
                            ),
                            const SizedBox(width: 12),
                            OutlinedButton.icon(
                              onPressed: () => _pickAndPredict(ImageSource.gallery),
                              icon: const Icon(Icons.photo_outlined),
                              label: const Text('Gallery'),
                            ),
                          ],
                        ),
                        const SizedBox(height: 24),
                        if (_predicting) const CircularProgressIndicator(),
                        if (_detections != null)
                          Card(
                            child: Padding(
                              padding: const EdgeInsets.all(16),
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                mainAxisSize: MainAxisSize.min,
                                children: [
                                  const Text('Detections', style: TextStyle(fontWeight: FontWeight.w600)),
                                  const SizedBox(height: 8),
                                  if (_detections!.isEmpty) const Text('No objects found.'),
                                  for (final d in _detections!)
                                    Padding(
                                      padding: const EdgeInsets.symmetric(vertical: 2),
                                      child: Row(
                                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                                        children: [Text(d.label), Text(d.confidence.toStringAsFixed(4))],
                                      ),
                                    ),
                                ],
                              ),
                            ),
                          ),
                        if (_predictions != null)
                          Card(
                            child: Padding(
                              padding: const EdgeInsets.all(16),
                              child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                mainAxisSize: MainAxisSize.min,
                                children: [
                                  const Text('Predictions', style: TextStyle(fontWeight: FontWeight.w600)),
                                  const SizedBox(height: 8),
                                  for (final entry in _predictions!.entries)
                                    Padding(
                                      padding: const EdgeInsets.symmetric(vertical: 2),
                                      child: Row(
                                        mainAxisAlignment: MainAxisAlignment.spaceBetween,
                                        children: [Text(entry.key), Text(entry.value.toStringAsFixed(4))],
                                      ),
                                    ),
                                ],
                              ),
                            ),
                          ),
                      ],
                    ),
                  ),
      ),
    );
  }
}

/// Draws a detector's boxes, given as fractions of the picture, over the picture.
class _BoxPainter extends CustomPainter {
  _BoxPainter(this.detections);

  final List<Detection> detections;

  @override
  void paint(Canvas canvas, Size size) {
    final stroke = Paint()
      ..style = PaintingStyle.stroke
      ..strokeWidth = 2
      ..color = const Color(0xFF1864AB);
    final fill = Paint()..color = const Color(0xFF1864AB);
    for (final d in detections) {
      final rect = Rect.fromLTWH(d.box.x * size.width, d.box.y * size.height, d.box.w * size.width, d.box.h * size.height);
      canvas.drawRect(rect, stroke);
      final text = TextPainter(
        text: TextSpan(text: '${d.label} ${d.confidence.toStringAsFixed(2)}', style: const TextStyle(color: Colors.white, fontSize: 12)),
        textDirection: TextDirection.ltr,
      )..layout();
      canvas.drawRect(Rect.fromLTWH(rect.left, rect.top, text.width + 8, text.height + 4), fill);
      text.paint(canvas, Offset(rect.left + 4, rect.top + 2));
    }
  }

  @override
  bool shouldRepaint(_BoxPainter oldDelegate) => oldDelegate.detections != detections;
}

/// Self-check screen: runs the bundle's golden sample through this app's
/// own [OmniTrainClient] and diffs the result against expected.json, the
/// platform's own prediction for that sample.
class VerifyScreen extends StatefulWidget {
  const VerifyScreen({required this.client, super.key});

  final OmniTrainClient client;

  @override
  State<VerifyScreen> createState() => _VerifyScreenState();
}

class _VerifyScreenState extends State<VerifyScreen> {
  static const _tolerance = 1e-3;

  // Object detection. The platform's prediction comes from the original weights through Ultralytics, which pads an
  // image only up to a multiple of 32 before the network; this client pads to the full square the exported graph was
  // built for. The same box therefore comes out a little different, and a borderline one may appear in only one list.
  // So only confident boxes are held to account, and by overlap and a loose confidence margin, not exact numbers.
  static const _confident = 0.35; // a box at least this confident on either side must have a partner on the other
  static const _minIou = 0.7;
  static const _confidenceMargin = 0.1;

  static double _iou(Box a, Box b) {
    final width = math.min(a.x + a.w, b.x + b.w) - math.max(a.x, b.x);
    final height = math.min(a.y + a.h, b.y + b.h) - math.max(a.y, b.y);
    final intersection = math.max(width, 0) * math.max(height, 0);
    final union = a.w * a.h + b.w * b.h - intersection;
    return union > 0 ? intersection / union : 0;
  }

  /// Whether [others] has a box of the same class that overlaps enough and is about as confident.
  static bool _hasPartner(Detection box, List<Detection> others) {
    final same = others.where((o) => o.label == box.label).toList();
    if (same.isEmpty) return false;
    final best = same.reduce((a, b) => _iou(box.box, b.box) > _iou(box.box, a.box) ? b : a);
    return _iou(box.box, best.box) >= _minIou && (best.confidence - box.confidence).abs() <= _confidenceMargin;
  }

  /// Verification lines for a detector, and whether it passed.
  static (List<String>, bool) verifyDetections(List<Detection> expected, List<Detection> actual) {
    final lines = <String>[];
    for (final (source, side, other, otherName) in [
      (expected, 'platform', actual, 'this app'),
      (actual, 'this app', expected, 'the platform'),
    ]) {
      for (final box in source) {
        if (box.confidence >= _confident && !_hasPartner(box, other)) {
          lines.add("MISMATCH $side found '${box.label}' (${box.confidence.toStringAsFixed(2)}); $otherName has no matching box");
        }
      }
    }
    if (lines.isEmpty) {
      final confident = expected.where((b) => b.confidence >= _confident).length;
      lines.add("OK — $confident confident box(es) match the platform's output (IoU >= $_minIou).");
    }
    return (lines, lines.length == 1 && lines.first.startsWith('OK'));
  }

  bool _running = true;
  List<String> _lines = [];
  bool? _ok;

  @override
  void initState() {
    super.initState();
    _run();
  }

  Future<void> _run() async {
    final lines = <String>[];
    var ok = true;
    try {
      final expectedJson = await rootBundle.loadString('assets/expected.json');
      final expected = jsonDecode(expectedJson) as Map<String, dynamic>;
      if (widget.client.isDetector) {
        final detections = expected['detections'] as List?;
        if (detections == null) {
          lines.add('expected.json has no detections to compare against.');
        } else {
          final platform = [
            for (final d in detections.cast<Map<String, dynamic>>())
              Detection(
                d['label'] as String,
                (d['confidence'] as num).toDouble(),
                Box(
                  ((d['box'] as Map)['x'] as num).toDouble(),
                  ((d['box'] as Map)['y'] as num).toDouble(),
                  ((d['box'] as Map)['w'] as num).toDouble(),
                  ((d['box'] as Map)['h'] as num).toDouble(),
                ),
              ),
          ];
          final sampleBytes = (await rootBundle.load('assets/${expected['sampleFile'] as String}')).buffer.asUint8List();
          final (found, passed) = verifyDetections(platform, await widget.client.detect(sampleBytes));
          lines.addAll(found);
          ok = passed;
        }
        setState(() {
          _lines = lines;
          _ok = ok;
          _running = false;
        });
        return;
      }
      final expectedPredictions = (expected['predictions'] as Map<String, dynamic>).map(
        (k, v) => MapEntry(k, (v as num).toDouble()),
      );
      final sampleFile = 'assets/${expected['sampleFile'] as String}';
      final sampleBytes = (await rootBundle.load(sampleFile)).buffer.asUint8List();

      final actual = await widget.client.predict(sampleBytes, topK: expectedPredictions.isEmpty ? 5 : expectedPredictions.length);

      if (expectedPredictions.isEmpty) {
        lines.add('expected.json has no predictions to compare against.');
      } else {
        final expectedTop1 = expectedPredictions.entries.reduce((a, b) => b.value > a.value ? b : a).key;
        final actualTop1 = actual.isEmpty ? null : actual.entries.reduce((a, b) => b.value > a.value ? b : a).key;

        if (actualTop1 != expectedTop1) {
          ok = false;
          lines.add("MISMATCH top-1 class: expected '$expectedTop1', got '$actualTop1'");
        }
        for (final entry in expectedPredictions.entries) {
          final actualProb = actual[entry.key];
          if (actualProb == null) {
            ok = false;
            lines.add("MISMATCH class '${entry.key}' missing from this client's output");
            continue;
          }
          final diff = (actualProb - entry.value).abs();
          if (diff > _tolerance) {
            ok = false;
            lines.add(
              "MISMATCH class '${entry.key}': expected ${entry.value.toStringAsFixed(4)}, "
              'got ${actualProb.toStringAsFixed(4)} (diff ${diff.toStringAsFixed(4)})',
            );
          }
        }
        if (ok) lines.add("OK — top-1 '$actualTop1' matches platform output within $_tolerance.");
      }
    } catch (e) {
      lines.add('Error: $e');
      ok = false;
    }
    setState(() {
      _lines = lines;
      _ok = ok;
      _running = false;
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Self-check')),
      body: Padding(
        padding: const EdgeInsets.all(24),
        child: _running
            ? const Center(child: CircularProgressIndicator())
            : Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    children: [
                      Icon(_ok == true ? Icons.check_circle : Icons.error, color: _ok == true ? Colors.green : Colors.red),
                      const SizedBox(width: 8),
                      Text(_ok == true ? 'Passed' : 'Failed', style: const TextStyle(fontWeight: FontWeight.w600, fontSize: 18)),
                    ],
                  ),
                  const SizedBox(height: 16),
                  for (final line in _lines) Text(line),
                ],
              ),
      ),
    );
  }
}
