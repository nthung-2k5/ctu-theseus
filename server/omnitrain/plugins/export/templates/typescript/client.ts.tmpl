/**
 * OmniTrain-generated inference client.
 *
 * Wraps the exported ONNX model with the preprocessing/postprocessing
 * Ludwig applied at training time, read from preprocessing.json — Ludwig's
 * exported ONNX graph is the bare model only (no resize/normalize, no
 * tokenization, no class-index decoding), so this client reconstructs that
 * step from the manifest rather than assuming a fixed tensor layout:
 * input/output tensor names are matched against the graph's actual names
 * at runtime, not hardcoded, since ONNX export doesn't guarantee a stable
 * naming convention across Ludwig versions.
 *
 * Implements preprocessing for:
 *   - a single `image` input with a `category`/`number` output (image
 *     classification/regression) — pass a file path to `predict()`.
 *   - one or more `number` inputs (tabular classification/regression) —
 *     pass a `{column: value}` record to `predict()`, one entry per input
 *     feature.
 *   - a `detections` output (object detection, YOLO) — pass an image path;
 *     `predict()` returns `[{label, confidence, box}]`, `box` being `{x, y, w, h}`:
 *     the top-left corner and size as fractions (0..1) of the image. The ONNX
 *     graph returns every candidate box; this client does the confidence
 *     filter, per-class non-maximum suppression and the undoing of the
 *     letterbox.
 *
 * Every other input type (text, audio, video) throws with a pointer to
 * preprocessing.json so you can adapt preprocessing yourself — text
 * tokenization in particular depends on the chosen encoder's own
 * vocabulary (Ludwig's built-in tokenizer, or a HuggingFace subword
 * tokenizer for bert/distilbert/roberta), which can't be generically
 * reconstructed from preprocessing.json alone. See README.md.
 */

import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import * as ort from 'onnxruntime-node'
import sharp from 'sharp'

interface PreprocessingInput {
  name: string
  type: string
  column: string
  ludwigPreprocessing?: Record<string, unknown>
  /** Absent: squash the whole image to height x width. */
  imageResize?: { mode?: string; size?: [number, number]; padValue?: number }
  imageNormalization?: { mean: [number, number, number]; std: [number, number, number] }
  numberNormalization?: {
    type: 'zscore' | 'minmax' | 'log1p' | 'iq'
    mean?: number
    std?: number
    min?: number
    max?: number
    q1?: number
    q2?: number
    q3?: number
  }
}

interface PreprocessingOutput {
  name: string
  type: string
  column: string
  classes?: string[]
  yoloOutput?: { confidenceThreshold?: number; iouThreshold?: number }
}

/** One object found in an image. `box` is the top-left corner and the size, as fractions (0..1) of the image. */
export interface Detection {
  label: string
  confidence: number
  box: { x: number; y: number; w: number; h: number }
}

interface PreprocessingManifest {
  schemaVersion: 1
  inputs: PreprocessingInput[]
  outputs: PreprocessingOutput[]
}

function matchTensorName(candidates: string[], preferred: string): string {
  if (candidates.length === 1) return candidates[0]
  const match = candidates.find((n) => n === preferred || n.startsWith(`${preferred}::`) || n.startsWith(`${preferred}_`))
  if (!match) {
    throw new Error(
      `Could not match an ONNX tensor to feature '${preferred}' among [${candidates.join(', ')}]. ` +
        'Inspect preprocessing.json and pass the tensor name explicitly if this model uses an unrecognized naming scheme.',
    )
  }
  return match
}

/** Rounds .5 to the nearest even integer, as Python's round() does (and torchvision's CenterCrop relies on). */
function roundHalfEven(x: number): number {
  const floor = Math.floor(x)
  const diff = x - floor
  if (diff < 0.5) return floor
  if (diff > 0.5) return floor + 1
  return floor % 2 === 0 ? floor : floor + 1
}

/**
 * For `imageResize.mode === 'shorter_edge_center_crop'`: scale so the SHORTER edge is `size` (the other edge is
 * truncated to a whole pixel), then centre-crop a size x size square. Same arithmetic as torchvision's
 * Resize(size) followed by CenterCrop(size), which is what the model was evaluated with.
 */
function shorterEdgeGeometry(width: number, height: number, size: number) {
  const [newWidth, newHeight] =
    width <= height ? [size, Math.floor((size * height) / width)] : [Math.floor((size * width) / height), size]
  return {
    width: newWidth,
    height: newHeight,
    left: roundHalfEven((newWidth - size) / 2),
    top: roundHalfEven((newHeight - size) / 2),
  }
}

/**
 * Indices of the boxes to keep, most confident first: within each class, a box is dropped when it overlaps a more
 * confident one by more than `iouThreshold` (intersection over union). Boxes are `[x1, y1, x2, y2]`.
 */
function nonMaxSuppression(boxes: number[][], scores: number[], classes: number[], iouThreshold: number): number[] {
  const kept: number[] = []
  for (const label of new Set(classes)) {
    let order = classes
      .map((c, i) => (c === label ? i : -1))
      .filter((i) => i >= 0)
      .sort((a, b) => scores[b] - scores[a] || a - b)
    while (order.length > 0) {
      const [first, ...rest] = order
      kept.push(first)
      const a = boxes[first]
      const areaFirst = (a[2] - a[0]) * (a[3] - a[1])
      order = rest.filter((i) => {
        const b = boxes[i]
        const width = Math.min(a[2], b[2]) - Math.max(a[0], b[0])
        const height = Math.min(a[3], b[3]) - Math.max(a[1], b[1])
        const intersection = Math.max(width, 0) * Math.max(height, 0)
        const union = areaFirst + (b[2] - b[0]) * (b[3] - b[1]) - intersection
        return intersection / Math.max(union, 1e-9) <= iouThreshold
      })
    }
  }
  return kept.sort((a, b) => scores[b] - scores[a])
}

function softmax(x: Float32Array): Float32Array {
  const max = Math.max(...x)
  const exp = x.map((v) => Math.exp(v - max))
  const sum = exp.reduce((a, b) => a + b, 0)
  return exp.map((v) => v / sum)
}

/**
 * Replicates the exact normalization Ludwig fit at train time
 * (ludwig.features.number_feature.numeric_transformation_registry) — the
 * ONNX graph itself has none: NumberInputFeature.forward() goes straight
 * from the raw tensor to its encoder.
 */
function preprocessNumber(value: number, spec: PreprocessingInput): Float32Array {
  let x = value
  const norm = spec.numberNormalization
  if (norm) {
    if (norm.type === 'zscore' && norm.std) {
      x = (x - (norm.mean ?? 0)) / norm.std
    } else if (norm.type === 'minmax' && norm.min !== undefined && norm.max !== undefined) {
      const span = norm.max - norm.min
      x = span ? (x - norm.min) / span : 0
    } else if (norm.type === 'log1p') {
      x = Math.log1p(x)
    } else if (norm.type === 'iq' && norm.q2 !== undefined) {
      const span = (norm.q3 ?? 0) - (norm.q1 ?? 0)
      x = span ? (x - norm.q2) / span : x - norm.q2
    }
    // Unrecognized normalization type: passed through unchanged — check
    // preprocessing.json's `numberNormalization` if predictions look off.
  }
  // 1-D, length 1 — matches Ludwig's own create_sample_input() for a
  // single-example number feature.
  return new Float32Array([x])
}

export class OmniTrainClient {
  private session!: ort.InferenceSession
  private manifest: PreprocessingManifest
  private inputSpecs: PreprocessingInput[]
  private inputSpec: PreprocessingInput
  private outputSpec: PreprocessingOutput
  private onnxInputNames!: Record<string, string>
  private onnxOutputName!: string
  private ready: Promise<void>
  /** Multiple inputs, or a single tabular (number) one, means predict() expects a {column: value} record rather than a file path. */
  readonly isTabular: boolean
  /** An object detector: `predict()` / `detect()` return boxes, not a `{className: probability}` record. */
  readonly isDetector: boolean

  constructor(
    private modelPath = join(import.meta.dirname, 'model.onnx'),
    preprocessingPath = join(import.meta.dirname, 'preprocessing.json'),
  ) {
    this.manifest = JSON.parse(readFileSync(preprocessingPath, 'utf-8'))
    this.inputSpecs = this.manifest.inputs
    this.inputSpec = this.inputSpecs[0]
    this.outputSpec = this.manifest.outputs[0]
    this.isTabular = this.inputSpecs.length > 1 || this.inputSpec.type === 'number'
    this.isDetector = this.outputSpec.type === 'detections'
    this.ready = this.init()
  }

  private async init(): Promise<void> {
    this.session = await ort.InferenceSession.create(this.modelPath)
    this.onnxInputNames = Object.fromEntries(
      this.inputSpecs.map((spec) => [spec.name, matchTensorName(this.session.inputNames, spec.column)]),
    )
    this.onnxOutputName = matchTensorName(this.session.outputNames, this.outputSpec.column)
  }

  private async preprocessImage(path: string): Promise<Float32Array> {
    const pp = (this.inputSpec.ludwigPreprocessing ?? {}) as { height?: number; width?: number }
    const height = pp.height ?? 224
    const width = pp.width ?? 224

    const mode = this.inputSpec.imageResize?.mode
    let pipeline = sharp(path)
    if (mode === undefined) {
      pipeline = pipeline.resize(width, height) // the whole image squashed to the target size
    } else if (mode === 'shorter_edge_center_crop') {
      const { width: sourceWidth, height: sourceHeight } = await sharp(path).metadata()
      if (!sourceWidth || !sourceHeight) throw new Error(`Could not read the size of image: ${path}`)
      const g = shorterEdgeGeometry(sourceWidth, sourceHeight, Math.min(width, height))
      // `extract` after `resize` crops the resized image, not the source.
      pipeline = pipeline.resize(g.width, g.height).extract({ left: g.left, top: g.top, width, height })
    } else {
      throw new Error(
        `Unsupported imageResize mode '${mode}'. See preprocessing.json's inputs[0].imageResize and adapt this client.`,
      )
    }

    const { data } = await pipeline.removeAlpha().raw().toBuffer({ resolveWithObject: true })

    // HWC uint8 -> CHW float32, [0,1], optionally normalized.
    const norm = this.inputSpec.imageNormalization
    const pixels = new Float32Array(3 * height * width)
    for (let y = 0; y < height; y++) {
      for (let x = 0; x < width; x++) {
        for (let c = 0; c < 3; c++) {
          let v = data[(y * width + x) * 3 + c] / 255
          if (norm) v = (v - norm.mean[c]) / norm.std[c]
          pixels[c * height * width + y * width + x] = v
        }
      }
    }
    return pixels
  }

  /**
   * The image as the detector's input tensor, and what is needed to map its boxes back. For
   * `imageResize.mode === 'letterbox'`: scale so the LONGER edge is `size`, pad the shorter one, centred, with
   * `padValue` grey up to a size x size square (the arithmetic of ultralytics.data.augment.LetterBox). RGB, 0..1,
   * no mean/std.
   */
  private async letterbox(path: string) {
    const resize = this.inputSpec.imageResize
    if (resize?.mode !== 'letterbox' || !resize.size) {
      throw new Error(
        `Unsupported imageResize mode '${resize?.mode}' for a detector. ` +
          "See preprocessing.json's inputs[0].imageResize and adapt this client.",
      )
    }
    const [height, width] = resize.size
    const pad = resize.padValue ?? 114
    const { width: originalWidth, height: originalHeight } = await sharp(path).metadata()
    if (!originalWidth || !originalHeight) throw new Error(`Could not read the size of image: ${path}`)

    const scale = Math.min(height / originalHeight, width / originalWidth)
    const newWidth = Math.round(originalWidth * scale)
    const newHeight = Math.round(originalHeight * scale)
    const left = Math.round((width - newWidth) / 2 - 0.1)
    const top = Math.round((height - newHeight) / 2 - 0.1)

    const { data } = await sharp(path)
      .removeAlpha()
      .resize(newWidth, newHeight, { kernel: 'linear' })
      .extend({
        top,
        bottom: height - newHeight - top,
        left,
        right: width - newWidth - left,
        background: { r: pad, g: pad, b: pad },
      })
      .raw()
      .toBuffer({ resolveWithObject: true })

    // HWC uint8 -> CHW float32, [0,1].
    const pixels = new Float32Array(3 * height * width)
    for (let y = 0; y < height; y++) {
      for (let x = 0; x < width; x++) {
        for (let c = 0; c < 3; c++) pixels[c * height * width + y * width + x] = data[(y * width + x) * 3 + c] / 255
      }
    }
    return { tensor: new ort.Tensor('float32', pixels, [1, 3, height, width]), scale, left, top, originalWidth, originalHeight }
  }

  /**
   * Boxes found in an image, most confident first. `confidence` and `iou` default to the thresholds in
   * preprocessing.json (`outputs[0].yoloOutput`).
   */
  async detect(path: string, options: { confidence?: number; iou?: number; maxDetections?: number } = {}): Promise<Detection[]> {
    await this.ready
    const info = this.outputSpec.yoloOutput ?? {}
    const confidence = options.confidence ?? info.confidenceThreshold ?? 0.25
    const iou = options.iou ?? info.iouThreshold ?? 0.7
    const maxDetections = options.maxDetections ?? 300
    const classes = this.outputSpec.classes ?? []

    const { tensor, scale, left, top, originalWidth, originalHeight } = await this.letterbox(path)
    const outputs = await this.session.run({ [this.onnxInputNames[this.inputSpec.name]]: tensor })
    const raw = outputs[this.onnxOutputName]
    // [1, 4 + classes, candidates]: row r of the table is data[r * candidates .. (r + 1) * candidates].
    const candidates = raw.dims[2]
    const data = raw.data as Float32Array

    const boxes: number[][] = []
    const scores: number[] = []
    const labels: number[] = []
    for (let i = 0; i < candidates; i++) {
      let best = 0
      let bestScore = -Infinity
      for (let c = 0; c < classes.length; c++) {
        const score = data[(4 + c) * candidates + i]
        if (score > bestScore) {
          bestScore = score
          best = c
        }
      }
      if (bestScore < confidence) continue
      const [cx, cy, w, h] = [0, 1, 2, 3].map((r) => data[r * candidates + i])
      boxes.push([cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2])
      scores.push(bestScore)
      labels.push(best)
    }

    const clamp = (v: number, max: number) => Math.min(Math.max(v, 0), max)
    const round = (v: number, places: number) => Math.round(v * 10 ** places) / 10 ** places
    return nonMaxSuppression(boxes, scores, labels, iou)
      .slice(0, maxDetections)
      .map((index) => {
        // Undo the letterbox: remove the padding, divide by the scale, clip to the image.
        const [bx1, by1, bx2, by2] = boxes[index]
        const x1 = clamp((Math.max(bx1, 0) - left) / scale, originalWidth)
        const x2 = clamp((Math.max(bx2, 0) - left) / scale, originalWidth)
        const y1 = clamp((Math.max(by1, 0) - top) / scale, originalHeight)
        const y2 = clamp((Math.max(by2, 0) - top) / scale, originalHeight)
        return {
          label: classes[labels[index]],
          confidence: round(scores[index], 4),
          box: {
            x: round(x1 / originalWidth, 6),
            y: round(y1 / originalHeight, 6),
            w: round((x2 - x1) / originalWidth, 6),
            h: round((y2 - y1) / originalHeight, 6),
          },
        }
      })
  }

  private preprocessRecord(record: Record<string, number>): Record<string, ort.Tensor> {
    const feed: Record<string, ort.Tensor> = {}
    for (const spec of this.inputSpecs) {
      if (spec.type !== 'number') {
        throw new Error(
          `No preprocessing implemented for input type '${spec.type}' in a multi-input model. ` +
            'See preprocessing.json and adapt this method.',
        )
      }
      if (!(spec.column in record)) {
        throw new Error(`Missing required field '${spec.column}'`)
      }
      const data = preprocessNumber(record[spec.column], spec)
      feed[this.onnxInputNames[spec.name]] = new ort.Tensor('float32', data, [1])
    }
    return feed
  }

  /**
   * Run inference and return `{className: probability}` sorted descending
   * (classification), or `{value}` (regression).
   *
   * `input` is a file path for a single `image` input, or a
   * `{column: value}` record — one entry per input feature — for a
   * tabular (`number`-only) model. An object detector returns its boxes
   * (see `detect`) instead of a `{className: probability}` record.
   */
  async predict(input: string | Record<string, number>, topK = 5): Promise<Record<string, number> | Detection[]> {
    await this.ready
    if (this.outputSpec.type === 'detections') {
      if (typeof input !== 'string') throw new Error('This model takes an image input — pass a file path.')
      return this.detect(input)
    }

    let feed: Record<string, ort.Tensor>
    if (this.isTabular) {
      if (typeof input !== 'object') {
        throw new Error('This model has tabular inputs — pass a {column: value} record, not a file path.')
      }
      feed = this.preprocessRecord(input)
    } else if (this.inputSpec.type === 'image') {
      if (typeof input !== 'string') {
        throw new Error('This model takes an image input — pass a file path.')
      }
      const pp = (this.inputSpec.ludwigPreprocessing ?? {}) as { height?: number; width?: number }
      const height = pp.height ?? 224
      const width = pp.width ?? 224
      const pixels = await this.preprocessImage(input)
      feed = { [this.onnxInputNames[this.inputSpec.name]]: new ort.Tensor('float32', pixels, [1, 3, height, width]) }
    } else {
      throw new Error(
        `No preprocessing implemented for input type '${this.inputSpec.type}'. ` +
          "See preprocessing.json's inputs[0].ludwigPreprocessing and adapt this method.",
      )
    }

    const outputs = await this.session.run(feed)
    const logits = outputs[this.onnxOutputName].data as Float32Array

    const classes = this.outputSpec.classes
    if (classes && classes.length === logits.length) {
      const probs = softmax(logits)
      const ranked = classes
        .map((name, i) => [name, probs[i]] as const)
        .sort((a, b) => b[1] - a[1])
        .slice(0, topK)
      return Object.fromEntries(ranked.map(([name, p]) => [name, Math.round(p * 10000) / 10000]))
    }

    return { value: logits[0] }
  }
}
