/**
 * OmniTrain-generated inference client.
 *
 * Wraps the exported ONNX model with the preprocessing/postprocessing
 * Ludwig applied at training time, read from preprocessing.json — Ludwig's
 * exported ONNX graph is the bare model only (no resize/normalize, no
 * tokenization, no class-index decoding), so this client reconstructs that
 * step from the manifest rather than assuming a fixed tensor layout:
 * input/output tensor names are matched against the graph's actual names
 * at runtime, not hardcoded, since ONNX export doesn't guarantee a stable
 * naming convention across Ludwig versions.
 *
 * Implements preprocessing for:
 *   - a single `image` input with a `category`/`number` output (image
 *     classification/regression) — pass a file path to `predict()`.
 *   - one or more `number` inputs (tabular classification/regression) —
 *     pass a `{column: value}` record to `predict()`, one entry per input
 *     feature.
 *   - a `detections` output (object detection, YOLO) — pass an image path;
 *     `predict()` returns `[{label, confidence, box}]`, `box` being `{x, y, w, h}`:
 *     the top-left corner and size as fractions (0..1) of the image. The ONNX
 *     graph returns every candidate box; this client does the confidence
 *     filter, per-class non-maximum suppression and the undoing of the
 *     letterbox.
 *
 *   - an `audio` input with an `audioSpectrogram` recipe (audio classification) — pass a
 *     path to a WAV file. The spectrogram is computed here, from the recipe in
 *     preprocessing.json; no audio library is needed.
 *
 *   - a `text` input with a `textTokens` recipe (text classification) — pass the text
 *     itself, a string, not a file path. It is split into words and looked up in the
 *     vocabulary that ships in preprocessing.json; no library is needed.
 *
 * Every other input type (video, Ludwig's text and audio, a scikit-learn text model) throws
 * with a pointer to preprocessing.json so you can adapt preprocessing yourself — text
 * tokenization in particular depends on the chosen encoder's own
 * vocabulary (Ludwig's built-in tokenizer, or a HuggingFace subword
 * tokenizer for bert/distilbert/roberta), which can't be generically
 * reconstructed from preprocessing.json alone. See README.md.
 */

import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import * as ort from 'onnxruntime-node'
import sharp from 'sharp'

/** `inputs[0].audioSpectrogram` (recipe "log_mel_v1"): every number the spectrogram needs. */
interface AudioRecipe {
  recipe: string
  sampleRate: number
  windowSamples: number
  windowsPerAudio: number
  frames: number
  stft: { nFft: number; hopLength: number }
  mel: { bands: number; fMin: number; fMax: number }
  logFloor: number
  normalization: { mean: number; std: number }
}

/** `inputs[0].textTokens` (recipe "word_ids_v1"): how a text becomes word ids. */
interface TextRecipe {
  recipe: string
  lowercase: { from: number; to: number; add: number }
  separatorRanges: [number, number][]
  maxTokens: number
  padId: number
  unknownId: number
  firstWordId: number
  vocabulary: string[]
}

interface PreprocessingInput {
  name: string
  type: string
  column: string
  audioSpectrogram?: AudioRecipe
  textTokens?: TextRecipe
  ludwigPreprocessing?: Record<string, unknown>
  /** Absent: squash the whole image to height x width. */
  imageResize?: { mode?: string; size?: [number, number]; padValue?: number }
  imageNormalization?: { mean: [number, number, number]; std: [number, number, number] }
  numberNormalization?: {
    type: 'zscore' | 'minmax' | 'log1p' | 'iq'
    mean?: number
    std?: number
    min?: number
    max?: number
    q1?: number
    q2?: number
    q3?: number
  }
}

interface PreprocessingOutput {
  name: string
  type: string
  column: string
  classes?: string[]
  yoloOutput?: { confidenceThreshold?: number; iouThreshold?: number }
}

/** One object found in an image. `box` is the top-left corner and the size, as fractions (0..1) of the image. */
export interface Detection {
  label: string
  confidence: number
  box: { x: number; y: number; w: number; h: number }
}

interface PreprocessingManifest {
  schemaVersion: 1
  inputs: PreprocessingInput[]
  outputs: PreprocessingOutput[]
}

function matchTensorName(candidates: string[], preferred: string): string {
  if (candidates.length === 1) return candidates[0]
  const match = candidates.find((n) => n === preferred || n.startsWith(`${preferred}::`) || n.startsWith(`${preferred}_`))
  if (!match) {
    throw new Error(
      `Could not match an ONNX tensor to feature '${preferred}' among [${candidates.join(', ')}]. ` +
        'Inspect preprocessing.json and pass the tensor name explicitly if this model uses an unrecognized naming scheme.',
    )
  }
  return match
}

/** Rounds .5 to the nearest even integer, as Python's round() does (and torchvision's CenterCrop relies on). */
function roundHalfEven(x: number): number {
  const floor = Math.floor(x)
  const diff = x - floor
  if (diff < 0.5) return floor
  if (diff > 0.5) return floor + 1
  return floor % 2 === 0 ? floor : floor + 1
}

/**
 * For `imageResize.mode === 'shorter_edge_center_crop'`: scale so the SHORTER edge is `size` (the other edge is
 * truncated to a whole pixel), then centre-crop a size x size square. Same arithmetic as torchvision's
 * Resize(size) followed by CenterCrop(size), which is what the model was evaluated with.
 */
function shorterEdgeGeometry(width: number, height: number, size: number) {
  const [newWidth, newHeight] =
    width <= height ? [size, Math.floor((size * height) / width)] : [Math.floor((size * width) / height), size]
  return {
    width: newWidth,
    height: newHeight,
    left: roundHalfEven((newWidth - size) / 2),
    top: roundHalfEven((newHeight - size) / 2),
  }
}

/**
 * Indices of the boxes to keep, most confident first: within each class, a box is dropped when it overlaps a more
 * confident one by more than `iouThreshold` (intersection over union). Boxes are `[x1, y1, x2, y2]`.
 */
function nonMaxSuppression(boxes: number[][], scores: number[], classes: number[], iouThreshold: number): number[] {
  const kept: number[] = []
  for (const label of new Set(classes)) {
    let order = classes
      .map((c, i) => (c === label ? i : -1))
      .filter((i) => i >= 0)
      .sort((a, b) => scores[b] - scores[a] || a - b)
    while (order.length > 0) {
      const [first, ...rest] = order
      kept.push(first)
      const a = boxes[first]
      const areaFirst = (a[2] - a[0]) * (a[3] - a[1])
      order = rest.filter((i) => {
        const b = boxes[i]
        const width = Math.min(a[2], b[2]) - Math.max(a[0], b[0])
        const height = Math.min(a[3], b[3]) - Math.max(a[1], b[1])
        const intersection = Math.max(width, 0) * Math.max(height, 0)
        const union = areaFirst + (b[2] - b[0]) * (b[3] - b[1]) - intersection
        return intersection / Math.max(union, 1e-9) <= iouThreshold
      })
    }
  }
  return kept.sort((a, b) => scores[b] - scores[a])
}

// -- Audio -----------------------------------------------------------------------------------------------------
// `inputs[0].audioSpectrogram` spelled out. The platform computes the same thing in numpy; the arithmetic is plain
// enough (a polyphase resampler, a radix-2 FFT, a mel filterbank) to follow in any language.

/** A WAV file's samples, one Float32Array per channel, in [-1, 1], and its sample rate. */
function readWav(file: Uint8Array): { channels: Float32Array[]; rate: number } {
  const view = new DataView(file.buffer, file.byteOffset, file.byteLength)
  const tag = (at: number) => String.fromCharCode(file[at], file[at + 1], file[at + 2], file[at + 3])
  if (file.length < 12 || tag(0) !== 'RIFF' || tag(8) !== 'WAVE') throw new Error('Not a WAV file (only WAV is supported)')
  let format: { code: number; channels: number; rate: number; bits: number } | undefined
  let dataAt = -1
  let dataSize = 0
  for (let at = 12; at + 8 <= file.length; ) {
    const size = view.getUint32(at + 4, true)
    const body = at + 8
    if (tag(at) === 'fmt ' && size >= 16) {
      let code = view.getUint16(body, true)
      if (code === 0xfffe && size >= 26) code = view.getUint16(body + 24, true) // extensible: the sub-format's tag
      format = { code, channels: view.getUint16(body + 2, true), rate: view.getUint32(body + 4, true), bits: view.getUint16(body + 14, true) }
    } else if (tag(at) === 'data') {
      dataAt = body
      dataSize = Math.min(size, file.length - body) // a streamed file may claim more than it holds
      break
    }
    at = body + size + (size & 1)
  }
  if (!format || dataAt < 0 || dataSize === 0) throw new Error('The WAV file has no format or no samples')
  const { code, channels, rate, bits } = format
  const width = bits >> 3
  if (channels < 1 || width < 1) throw new Error('The WAV file has no channels')
  const frames = Math.floor(dataSize / (width * channels))
  const read = (at: number): number => {
    if (code === 1 && bits === 8) return (view.getUint8(at) - 128) / 128
    if (code === 1 && bits === 16) return view.getInt16(at, true) / 32767
    if (code === 1 && bits === 24) {
      const v = view.getUint8(at) | (view.getUint8(at + 1) << 8) | (view.getUint8(at + 2) << 16)
      return (v >= 0x800000 ? v - 0x1000000 : v) / 8388607
    }
    if (code === 1 && bits === 32) return view.getInt32(at, true) / 2147483647
    if (code === 3 && bits === 32) return view.getFloat32(at, true)
    if (code === 3 && bits === 64) return view.getFloat64(at, true)
    throw new Error(`Unsupported WAV encoding (format ${code}, ${bits} bits)`)
  }
  const out = Array.from({ length: channels }, () => new Float32Array(frames))
  for (let f = 0; f < frames; f++) {
    for (let c = 0; c < channels; c++) out[c][f] = read(dataAt + (f * channels + c) * width)
  }
  return { channels: out, rate }
}

function gcd(a: number, b: number): number {
  return b === 0 ? a : gcd(b, a % b)
}

/** Modified Bessel function of the first kind, order 0 (the Kaiser window's building block). */
function besselI0(x: number): number {
  let sum = 1
  let term = 1
  for (let k = 1; k < 500; k++) {
    term *= (x / (2 * k)) ** 2
    sum += term
    if (term < sum * 1e-17) break
  }
  return sum
}

/**
 * `scipy.signal.resample_poly(x, up, down)`: out[i] = sum over k in -H..H of h[H + k] * x[(i * down + k) / up],
 * counting the k for which i * down + k is a multiple of `up` and the index is inside the recording. `h` is a
 * Kaiser-windowed (beta 5) sinc low-pass of 2H + 1 taps, H = 10 * max(up, down), scaled to a gain of `up`.
 */
function resample(x: Float32Array | Float64Array, rate: number, target: number): Float32Array {
  const divisor = gcd(rate, target)
  const up = target / divisor
  const down = rate / divisor
  const big = Math.max(up, down)
  const half = 10 * big
  const sinc = (v: number) => (v === 0 ? 1 : Math.sin(Math.PI * v) / (Math.PI * v))
  const taps = new Float64Array(2 * half + 1)
  const i0Beta = besselI0(5)
  let total = 0
  for (let n = 0; n <= 2 * half; n++) {
    const ratio = (n - half) / half
    const window = besselI0(5 * Math.sqrt(Math.max(1 - ratio * ratio, 0))) / i0Beta
    taps[n] = (sinc((n - half) / big) / big) * window
    total += taps[n]
  }
  for (let n = 0; n <= 2 * half; n++) taps[n] *= up / total

  const outLength = Math.floor((x.length * up + down - 1) / down)
  const out = new Float32Array(outLength)
  for (let i = 0; i < outLength; i++) {
    const position = i * down
    const anchor = Math.floor(position / up)
    const phase = position % up
    const first = -Math.floor((half - phase) / up)
    const last = Math.floor((half + phase) / up)
    let acc = 0
    for (let d = first; d <= last; d++) {
      const index = anchor + d
      if (index >= 0 && index < x.length) acc += taps[half - phase + d * up] * x[index]
    }
    out[i] = acc
  }
  return out
}

/** Where the windows of a `total`-sample recording start (`audioSpectrogram.windowStarts`). */
function windowStarts(total: number, length: number, count: number): number[] {
  if (total <= length) return [0]
  const room = total - length
  if (count <= 1) return [Math.floor(room / 2)]
  const starts = new Set<number>()
  for (let i = 0; i < count; i++) starts.add(roundHalfEven((i * room) / (count - 1)))
  return [...starts].sort((a, b) => a - b)
}

/** In-place radix-2 FFT of `re` + i `im` (length a power of two). */
function fft(re: Float64Array, im: Float64Array): void {
  const n = re.length
  for (let i = 1, j = 0; i < n; i++) {
    let bit = n >> 1
    for (; j & bit; bit >>= 1) j ^= bit
    j ^= bit
    if (i < j) {
      ;[re[i], re[j]] = [re[j], re[i]]
      ;[im[i], im[j]] = [im[j], im[i]]
    }
  }
  for (let size = 2; size <= n; size <<= 1) {
    const angle = (-2 * Math.PI) / size
    for (let start = 0; start < n; start += size) {
      for (let k = 0; k < size / 2; k++) {
        const wr = Math.cos(angle * k)
        const wi = Math.sin(angle * k)
        const a = start + k
        const b = a + size / 2
        const tr = re[b] * wr - im[b] * wi
        const ti = re[b] * wi + im[b] * wr
        re[b] = re[a] - tr
        im[b] = im[a] - ti
        re[a] += tr
        im[a] += ti
      }
    }
  }
}

/** `[nFft / 2 + 1][bands]` triangular HTK mel filters, no area normalisation. */
function melFilterbank(sampleRate: number, nFft: number, bands: number, fMin: number, fMax: number): Float64Array[] {
  const toMel = (hz: number) => 2595 * Math.log10(1 + hz / 700)
  const edges = Array.from({ length: bands + 2 }, (_, i) => {
    const mel = toMel(fMin) + ((toMel(fMax) - toMel(fMin)) * i) / (bands + 1)
    return 700 * (10 ** (mel / 2595) - 1)
  })
  const bins = nFft / 2 + 1
  const filters = Array.from({ length: bins }, () => new Float64Array(bands))
  for (let bin = 0; bin < bins; bin++) {
    const hz = (sampleRate / 2) * (bin / (bins - 1))
    for (let b = 0; b < bands; b++) {
      const rising = (hz - edges[b]) / (edges[b + 1] - edges[b])
      const falling = (edges[b + 2] - hz) / (edges[b + 2] - edges[b + 1])
      filters[bin][b] = Math.max(0, Math.min(rising, falling))
    }
  }
  return filters
}

/** The standardised log-mel spectrogram of one window, `[bands][frames]` flattened row by row. */
function spectrogramOf(window: Float32Array, recipe: AudioRecipe, filters: Float64Array[]): Float32Array {
  const { nFft, hopLength } = recipe.stft
  const bands = recipe.mel.bands
  const frames = recipe.frames
  const hann = Float64Array.from({ length: nFft }, (_, n) => 0.5 - 0.5 * Math.cos((2 * Math.PI * n) / nFft))
  const out = new Float32Array(bands * frames)
  const re = new Float64Array(nFft)
  const im = new Float64Array(nFft)
  const bins = nFft / 2 + 1
  const power = new Float64Array(bins)
  for (let f = 0; f < frames; f++) {
    for (let n = 0; n < nFft; n++) {
      re[n] = window[f * hopLength + n] * hann[n]
      im[n] = 0
    }
    fft(re, im)
    for (let k = 0; k < bins; k++) power[k] = re[k] * re[k] + im[k] * im[k]
    for (let b = 0; b < bands; b++) {
      let mel = 0
      for (let k = 0; k < bins; k++) mel += power[k] * filters[k][b]
      const logMel = Math.fround(Math.log(mel + recipe.logFloor))
      out[b * frames + f] = (logMel - recipe.normalization.mean) / recipe.normalization.std
    }
  }
  return out
}

function softmax(x: Float32Array): Float32Array {
  const max = Math.max(...x)
  const exp = x.map((v) => Math.exp(v - max))
  const sum = exp.reduce((a, b) => a + b, 0)
  return exp.map((v) => v / sum)
}

/**
 * Replicates the exact normalization Ludwig fit at train time
 * (ludwig.features.number_feature.numeric_transformation_registry) — the
 * ONNX graph itself has none: NumberInputFeature.forward() goes straight
 * from the raw tensor to its encoder.
 */
function preprocessNumber(value: number, spec: PreprocessingInput): Float32Array {
  let x = value
  const norm = spec.numberNormalization
  if (norm) {
    if (norm.type === 'zscore' && norm.std) {
      x = (x - (norm.mean ?? 0)) / norm.std
    } else if (norm.type === 'minmax' && norm.min !== undefined && norm.max !== undefined) {
      const span = norm.max - norm.min
      x = span ? (x - norm.min) / span : 0
    } else if (norm.type === 'log1p') {
      x = Math.log1p(x)
    } else if (norm.type === 'iq' && norm.q2 !== undefined) {
      const span = (norm.q3 ?? 0) - (norm.q1 ?? 0)
      x = span ? (x - norm.q2) / span : x - norm.q2
    }
    // Unrecognized normalization type: passed through unchanged — check
    // preprocessing.json's `numberNormalization` if predictions look off.
  }
  // 1-D, length 1 — matches Ludwig's own create_sample_input() for a
  // single-example number feature.
  return new Float32Array([x])
}

/** Which UTF-16 code units separate tokens, as a lookup table built from the recipe's ranges. */
function separatorTable(ranges: [number, number][]): Uint8Array {
  const table = new Uint8Array(0x10000)
  for (const [lo, hi] of ranges) table.fill(1, lo, Math.min(hi, 0xffff) + 1)
  return table
}

/** The tokens of a text: the ASCII letters A-Z lower-cased, cut at every run of separator code units. */
function tokenize(text: string, recipe: TextRecipe, separators: Uint8Array): string[] {
  const { from, to, add } = recipe.lowercase
  const tokens: string[] = []
  let current = ''
  for (let i = 0; i < text.length; i++) {
    const unit = text.charCodeAt(i)
    if (separators[unit] === 1) {
      if (current !== '') tokens.push(current)
      current = ''
    } else {
      current += String.fromCharCode(unit >= from && unit <= to ? unit + add : unit)
    }
  }
  if (current !== '') tokens.push(current)
  return tokens
}

export class OmniTrainClient {
  private session!: ort.InferenceSession
  private manifest: PreprocessingManifest
  private inputSpecs: PreprocessingInput[]
  private inputSpec: PreprocessingInput
  private outputSpec: PreprocessingOutput
  private onnxInputNames!: Record<string, string>
  private onnxOutputName!: string
  private ready: Promise<void>
  /** Multiple inputs, or a single tabular (number) one, means predict() expects a {column: value} record rather than a file path. */
  readonly isTabular: boolean
  /** An object detector: `predict()` / `detect()` return boxes, not a `{className: probability}` record. */
  readonly isDetector: boolean
  /** An audio classifier: `predict()` takes the path of a WAV file. */
  readonly isAudio: boolean
  /** A text classifier: `predict()` takes the text itself, not a path. */
  readonly isText: boolean
  private textSeparators = new Uint8Array(0)
  private textIds = new Map<string, number>()

  constructor(
    private modelPath = join(import.meta.dirname, 'model.onnx'),
    preprocessingPath = join(import.meta.dirname, 'preprocessing.json'),
  ) {
    this.manifest = JSON.parse(readFileSync(preprocessingPath, 'utf-8'))
    this.inputSpecs = this.manifest.inputs
    this.inputSpec = this.inputSpecs[0]
    this.outputSpec = this.manifest.outputs[0]
    this.isTabular = this.inputSpecs.length > 1 || this.inputSpec.type === 'number'
    this.isDetector = this.outputSpec.type === 'detections'
    this.isAudio = this.inputSpec.type === 'audio' && this.inputSpec.audioSpectrogram !== undefined
    if (this.isAudio && this.inputSpec.audioSpectrogram?.recipe !== 'log_mel_v1') {
      throw new Error(
        `Unknown audio recipe '${this.inputSpec.audioSpectrogram?.recipe}'. ` +
          "See preprocessing.json's inputs[0].audioSpectrogram and adapt this client.",
      )
    }
    this.isText = this.inputSpec.type === 'text' && this.inputSpec.textTokens !== undefined
    if (this.isText) {
      const recipe = this.inputSpec.textTokens as TextRecipe
      if (recipe.recipe !== 'word_ids_v1') {
        throw new Error(
          `Unknown text recipe '${recipe.recipe}'. See preprocessing.json's inputs[0].textTokens and adapt this client.`,
        )
      }
      this.textSeparators = separatorTable(recipe.separatorRanges)
      recipe.vocabulary.forEach((word, i) => this.textIds.set(word, recipe.firstWordId + i))
    }
    this.ready = this.init()
  }

  private async init(): Promise<void> {
    this.session = await ort.InferenceSession.create(this.modelPath)
    this.onnxInputNames = Object.fromEntries(
      this.inputSpecs.map((spec) => [spec.name, matchTensorName(this.session.inputNames, spec.column)]),
    )
    this.onnxOutputName = matchTensorName(this.session.outputNames, this.outputSpec.column)
  }

  private async preprocessImage(path: string): Promise<Float32Array> {
    const pp = (this.inputSpec.ludwigPreprocessing ?? {}) as { height?: number; width?: number }
    const height = pp.height ?? 224
    const width = pp.width ?? 224

    const mode = this.inputSpec.imageResize?.mode
    let pipeline = sharp(path)
    if (mode === undefined) {
      pipeline = pipeline.resize(width, height) // the whole image squashed to the target size
    } else if (mode === 'shorter_edge_center_crop') {
      const { width: sourceWidth, height: sourceHeight } = await sharp(path).metadata()
      if (!sourceWidth || !sourceHeight) throw new Error(`Could not read the size of image: ${path}`)
      const g = shorterEdgeGeometry(sourceWidth, sourceHeight, Math.min(width, height))
      // `extract` after `resize` crops the resized image, not the source.
      pipeline = pipeline.resize(g.width, g.height).extract({ left: g.left, top: g.top, width, height })
    } else {
      throw new Error(
        `Unsupported imageResize mode '${mode}'. See preprocessing.json's inputs[0].imageResize and adapt this client.`,
      )
    }

    const { data } = await pipeline.removeAlpha().raw().toBuffer({ resolveWithObject: true })

    // HWC uint8 -> CHW float32, [0,1], optionally normalized.
    const norm = this.inputSpec.imageNormalization
    const pixels = new Float32Array(3 * height * width)
    for (let y = 0; y < height; y++) {
      for (let x = 0; x < width; x++) {
        for (let c = 0; c < 3; c++) {
          let v = data[(y * width + x) * 3 + c] / 255
          if (norm) v = (v - norm.mean[c]) / norm.std[c]
          pixels[c * height * width + y * width + x] = v
        }
      }
    }
    return pixels
  }

  /**
   * The image as the detector's input tensor, and what is needed to map its boxes back. For
   * `imageResize.mode === 'letterbox'`: scale so the LONGER edge is `size`, pad the shorter one, centred, with
   * `padValue` grey up to a size x size square (the arithmetic of ultralytics.data.augment.LetterBox). RGB, 0..1,
   * no mean/std.
   */
  private async letterbox(path: string) {
    const resize = this.inputSpec.imageResize
    if (resize?.mode !== 'letterbox' || !resize.size) {
      throw new Error(
        `Unsupported imageResize mode '${resize?.mode}' for a detector. ` +
          "See preprocessing.json's inputs[0].imageResize and adapt this client.",
      )
    }
    const [height, width] = resize.size
    const pad = resize.padValue ?? 114
    const { width: originalWidth, height: originalHeight } = await sharp(path).metadata()
    if (!originalWidth || !originalHeight) throw new Error(`Could not read the size of image: ${path}`)

    const scale = Math.min(height / originalHeight, width / originalWidth)
    const newWidth = Math.round(originalWidth * scale)
    const newHeight = Math.round(originalHeight * scale)
    const left = Math.round((width - newWidth) / 2 - 0.1)
    const top = Math.round((height - newHeight) / 2 - 0.1)

    const { data } = await sharp(path)
      .removeAlpha()
      .resize(newWidth, newHeight, { kernel: 'linear' })
      .extend({
        top,
        bottom: height - newHeight - top,
        left,
        right: width - newWidth - left,
        background: { r: pad, g: pad, b: pad },
      })
      .raw()
      .toBuffer({ resolveWithObject: true })

    // HWC uint8 -> CHW float32, [0,1].
    const pixels = new Float32Array(3 * height * width)
    for (let y = 0; y < height; y++) {
      for (let x = 0; x < width; x++) {
        for (let c = 0; c < 3; c++) pixels[c * height * width + y * width + x] = data[(y * width + x) * 3 + c] / 255
      }
    }
    return { tensor: new ort.Tensor('float32', pixels, [1, 3, height, width]), scale, left, top, originalWidth, originalHeight }
  }

  /**
   * Boxes found in an image, most confident first. `confidence` and `iou` default to the thresholds in
   * preprocessing.json (`outputs[0].yoloOutput`).
   */
  async detect(path: string, options: { confidence?: number; iou?: number; maxDetections?: number } = {}): Promise<Detection[]> {
    await this.ready
    const info = this.outputSpec.yoloOutput ?? {}
    const confidence = options.confidence ?? info.confidenceThreshold ?? 0.25
    const iou = options.iou ?? info.iouThreshold ?? 0.7
    const maxDetections = options.maxDetections ?? 300
    const classes = this.outputSpec.classes ?? []

    const { tensor, scale, left, top, originalWidth, originalHeight } = await this.letterbox(path)
    const outputs = await this.session.run({ [this.onnxInputNames[this.inputSpec.name]]: tensor })
    const raw = outputs[this.onnxOutputName]
    // [1, 4 + classes, candidates]: row r of the table is data[r * candidates .. (r + 1) * candidates].
    const candidates = raw.dims[2]
    const data = raw.data as Float32Array

    const boxes: number[][] = []
    const scores: number[] = []
    const labels: number[] = []
    for (let i = 0; i < candidates; i++) {
      let best = 0
      let bestScore = -Infinity
      for (let c = 0; c < classes.length; c++) {
        const score = data[(4 + c) * candidates + i]
        if (score > bestScore) {
          bestScore = score
          best = c
        }
      }
      if (bestScore < confidence) continue
      const [cx, cy, w, h] = [0, 1, 2, 3].map((r) => data[r * candidates + i])
      boxes.push([cx - w / 2, cy - h / 2, cx + w / 2, cy + h / 2])
      scores.push(bestScore)
      labels.push(best)
    }

    const clamp = (v: number, max: number) => Math.min(Math.max(v, 0), max)
    const round = (v: number, places: number) => Math.round(v * 10 ** places) / 10 ** places
    return nonMaxSuppression(boxes, scores, labels, iou)
      .slice(0, maxDetections)
      .map((index) => {
        // Undo the letterbox: remove the padding, divide by the scale, clip to the image.
        const [bx1, by1, bx2, by2] = boxes[index]
        const x1 = clamp((Math.max(bx1, 0) - left) / scale, originalWidth)
        const x2 = clamp((Math.max(bx2, 0) - left) / scale, originalWidth)
        const y1 = clamp((Math.max(by1, 0) - top) / scale, originalHeight)
        const y2 = clamp((Math.max(by2, 0) - top) / scale, originalHeight)
        return {
          label: classes[labels[index]],
          confidence: round(scores[index], 4),
          box: {
            x: round(x1 / originalWidth, 6),
            y: round(y1 / originalHeight, 6),
            w: round((x2 - x1) / originalWidth, 6),
            h: round((y2 - y1) / originalHeight, 6),
          },
        }
      })
  }

  /** The recording as a batch of spectrograms, `[windows, 1, bands, frames]`, by `audioSpectrogram`. */
  private audioSpectrograms(path: string): ort.Tensor {
    const recipe = this.inputSpec.audioSpectrogram as AudioRecipe
    const { channels, rate } = readWav(readFileSync(path))
    const frames = channels[0].length
    // The channels' mean, at double precision as the platform does it.
    const mono = new Float64Array(frames)
    for (const channel of channels) for (let i = 0; i < frames; i++) mono[i] += channel[i]
    for (let i = 0; i < frames; i++) mono[i] /= channels.length
    const wave = resample(mono, rate, recipe.sampleRate)
    if (wave.length === 0) throw new Error('The recording has no samples')

    const length = recipe.windowSamples
    const filters = melFilterbank(recipe.sampleRate, recipe.stft.nFft, recipe.mel.bands, recipe.mel.fMin, recipe.mel.fMax)
    const starts = windowStarts(wave.length, length, recipe.windowsPerAudio)
    const size = recipe.mel.bands * recipe.frames
    const batch = new Float32Array(starts.length * size)
    starts.forEach((start, w) => {
      const window = new Float32Array(length) // zero-padded at the end when the recording runs out
      window.set(wave.subarray(start, Math.min(start + length, wave.length)))
      batch.set(spectrogramOf(window, recipe, filters), w * size)
    })
    return new ort.Tensor('float32', batch, [starts.length, 1, recipe.mel.bands, recipe.frames])
  }

  /** Class probabilities of a recording: each window's logits through a softmax, averaged over the windows. */
  private async classifyAudio(path: string, topK: number): Promise<Record<string, number>> {
    const input = this.audioSpectrograms(path)
    const outputs = await this.session.run({ [this.onnxInputNames[this.inputSpec.name]]: input })
    const logits = outputs[this.onnxOutputName].data as Float32Array
    const windows = input.dims[0]
    const classes = this.outputSpec.classes ?? []
    const mean = new Float64Array(classes.length)
    for (let w = 0; w < windows; w++) {
      const probs = softmax(logits.subarray(w * classes.length, (w + 1) * classes.length))
      for (let c = 0; c < classes.length; c++) mean[c] += probs[c] / windows
    }
    return Object.fromEntries(
      classes
        .map((name, i) => [name, mean[i]] as const)
        .sort((a, b) => b[1] - a[1])
        .slice(0, topK)
        .map(([name, p]) => [name, Math.round(p * 10000) / 10000]),
    )
  }

  /** `[1, maxTokens]` int64 word ids: the first maxTokens tokens looked up in the vocabulary, padded at the end. */
  private textTokens(text: string): ort.Tensor {
    const recipe = this.inputSpec.textTokens as TextRecipe
    const ids = new BigInt64Array(recipe.maxTokens).fill(BigInt(recipe.padId))
    const tokens = tokenize(text, recipe, this.textSeparators).slice(0, recipe.maxTokens)
    tokens.forEach((token, i) => {
      ids[i] = BigInt(this.textIds.get(token) ?? recipe.unknownId)
    })
    return new ort.Tensor('int64', ids, [1, recipe.maxTokens])
  }

  private preprocessRecord(record: Record<string, number>): Record<string, ort.Tensor> {
    const feed: Record<string, ort.Tensor> = {}
    for (const spec of this.inputSpecs) {
      if (spec.type !== 'number') {
        throw new Error(
          `No preprocessing implemented for input type '${spec.type}' in a multi-input model. ` +
            'See preprocessing.json and adapt this method.',
        )
      }
      if (!(spec.column in record)) {
        throw new Error(`Missing required field '${spec.column}'`)
      }
      const data = preprocessNumber(record[spec.column], spec)
      feed[this.onnxInputNames[spec.name]] = new ort.Tensor('float32', data, [1])
    }
    return feed
  }

  /**
   * Run inference and return `{className: probability}` sorted descending
   * (classification), or `{value}` (regression).
   *
   * `input` is a file path for a single `image` or `audio` input, the text itself for a
   * `text` input, or a `{column: value}` record — one entry per input feature — for a
   * tabular (`number`-only) model. An object detector returns its boxes
   * (see `detect`) instead of a `{className: probability}` record.
   */
  async predict(input: string | Record<string, number>, topK = 5): Promise<Record<string, number> | Detection[]> {
    await this.ready
    if (this.outputSpec.type === 'detections') {
      if (typeof input !== 'string') throw new Error('This model takes an image input — pass a file path.')
      return this.detect(input)
    }

    if (this.isAudio) {
      if (typeof input !== 'string') throw new Error('This model takes an audio input — pass a path to a WAV file.')
      return this.classifyAudio(input, topK)
    }

    let feed: Record<string, ort.Tensor>
    if (this.isText) {
      if (typeof input !== 'string') throw new Error('This model takes a text input — pass the text as a string.')
      feed = { [this.onnxInputNames[this.inputSpec.name]]: this.textTokens(input) }
    } else if (this.isTabular) {
      if (typeof input !== 'object') {
        throw new Error('This model has tabular inputs — pass a {column: value} record, not a file path.')
      }
      feed = this.preprocessRecord(input)
    } else if (this.inputSpec.type === 'image') {
      if (typeof input !== 'string') {
        throw new Error('This model takes an image input — pass a file path.')
      }
      const pp = (this.inputSpec.ludwigPreprocessing ?? {}) as { height?: number; width?: number }
      const height = pp.height ?? 224
      const width = pp.width ?? 224
      const pixels = await this.preprocessImage(input)
      feed = { [this.onnxInputNames[this.inputSpec.name]]: new ort.Tensor('float32', pixels, [1, 3, height, width]) }
    } else {
      throw new Error(
        `No preprocessing implemented for input type '${this.inputSpec.type}'. ` +
          "See preprocessing.json's inputs[0].ludwigPreprocessing and adapt this method.",
      )
    }

    const outputs = await this.session.run(feed)
    const logits = outputs[this.onnxOutputName].data as Float32Array

    const classes = this.outputSpec.classes
    if (classes && classes.length === logits.length) {
      const probs = softmax(logits)
      const ranked = classes
        .map((name, i) => [name, probs[i]] as const)
        .sort((a, b) => b[1] - a[1])
        .slice(0, topK)
      return Object.fromEntries(ranked.map(([name, p]) => [name, Math.round(p * 10000) / 10000]))
    }

    return { value: logits[0] }
  }
}
